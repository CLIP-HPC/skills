{
  "description": "Ask before Bash commands that delete, move, or overwrite data under /groups",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$CBE_PROTECTED_PATHS\" ] || [ -d /groups ] || exit 0; exec python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/guard_groups.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
