{
  "description": "Ask before commands and file edits that delete, move, or overwrite data under /groups, also through ssh",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "command -v python3 >/dev/null 2>&1 || exit 0; exec python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/guard_groups.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
